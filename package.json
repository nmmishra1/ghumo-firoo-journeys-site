{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx --env-file=.env server/razorpay-server.ts",
    "dev:all": "concurrently -k -n SERVER,WEB -c blue,green \"npm:server\" \"npm:dev\"",
    "build": "node scripts/seo-validate.mjs && vite build --mode production",
    "build:dev": "vite build --mode development",
    "build:server": "npx esbuild server/razorpay-server.ts --bundle --platform=node --outfile=dist-server/app.js",
    "generate:sitemap": "tsx scripts/generate-sitemap.mts",
    "postbuild": "npm run generate:sitemap && node scripts/run-snap.js && node scripts/copy-backend.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "seo:validate": "node scripts/seo-validate.mjs"
  },
  "reactSnap": {
    "source": "dist",
    "destination": "dist",
    "concurrency": 1,
    "fixWebpackChunksIssue": false,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "skipThirdPartyRequests": true,
    "waitFor": 1000,
    "waitUntil": "networkidle2",
    "include": [
      "/",
      "/about",
      "/contact",
      "/packages",
      "/faq",
      "/enquire-now",
      "/booking",
      "/terms-of-service",
      "/privacy-policy",
      "/blog",
      "/landing/char-dham-road",
      "/packages/rann-utsav",
      "/packages/char-dham-yatra",
      "/packages/kashmir-paradise",
      "/packages/europe",
      "/packages/bali-paradise",
      "/packages/leh-ladakh-tour",
      "/packages/rajasthan-royal",
      "/packages/kerala-backwaters",
      "/packages/goa-beach-holiday",
      "/packages/himachal-hill-stations",
      "/packages/dubai-delights",
      "/packages/singapore",
      "/packages/georgia-adventure"
    ]
  },
  "dependencies": {
